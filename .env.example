# Copia este ficheiro para .env.local (na raiz do projeto, ao lado do package.json)
# e preenche com os valores do teu projeto Supabase (Project Settings > API).
# A chave "publishable" (ou "anon") é pública por desenho. NUNCA uses a "secret" / "service_role".
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
